# ==============================================================================
# Google Cloud & Credentials Configuration
# ==============================================================================
# Download key from: Google Cloud Console > IAM & Admin > Service Accounts > Keys (JSON)
# Place credential.json in the backend/ directory or set custom path below.
GOOGLE_CREDENTIALS_PATH=credential.json
GOOGLE_PROJECT_ID=your-gcp-project-id

# ==============================================================================
# API & Timeout Settings
# ==============================================================================
GMAIL_API_TIMEOUT=30          # Max timeout for Gmail API calls (seconds)
DRIVE_API_TIMEOUT=30          # Max timeout for Google Drive API calls (seconds)
MAX_RESULTS_DEFAULT=10        # Default number of search results returned per call
MAX_RESULTS_MAX=100           # Maximum cap for search results

# ==============================================================================
# Security, Rate Limiting & Guardrails
# ==============================================================================
RATE_LIMIT_ENABLED=true       # Toggle rate limiting
RATE_LIMIT_REQUESTS=10        # Maximum requests allowed per time window
RATE_LIMIT_WINDOW=1           # Time window in seconds (10 req / 1 sec)
MAX_EMAIL_SIZE=52428800       # Maximum email payload size in bytes (50 MB)
MAX_QUERY_LENGTH=256          # Maximum allowed length for search queries (prompt injection defense)

# ==============================================================================
# Application & Feature Flags
# ==============================================================================
APP_NAME=Gmail-Drive-MCP-Server
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_EMAIL_SEND=true        # Toggle permission to send emails
ENABLE_FILE_DOWNLOAD=true     # Toggle permission to inspect/download Drive files

# ==============================================================================
# Logging, Audit & Compliance
# ==============================================================================
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_PATH=logs/audit.json
GDPR_ENABLED=true
PII_MASKING_ENABLED=true       # Redacts personal identifiable information in logs
DATA_RETENTION_DAYS=30

# ==============================================================================
# Caching & Retry Settings
# ==============================================================================
CACHE_CREDENTIALS=true
CREDENTIALS_CACHE_TTL=3600    # OAuth token cache duration (seconds)
FILE_METADATA_CACHE_TTL=300   # Metadata cache duration (seconds)
MAX_RETRIES=3                 # Max retries on transient API failure
RETRY_BACKOFF_BASE=1.0        # Exponential backoff base (seconds)
RETRY_BACKOFF_MAX=32.0        # Max backoff wait time (seconds)

# ==============================================================================
# Monitoring & Metrics
# ==============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8001
METRICS_NAMESPACE=gmail_drive_mcp

